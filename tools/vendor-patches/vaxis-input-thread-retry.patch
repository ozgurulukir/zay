+    /// Reset the cancellation event before starting a new input loop.
+    pub fn resetInputCancellation(self: *WindowsTty) !void {
+        if (ResetEvent(self.cancel_event) == .FALSE)
+            return windows.unexpectedError(windows.GetLastError());
+    }
+
+    /// Cancel a thread blocked waiting for console input.
+    pub fn cancelInput(self: *WindowsTty) !void {
+        if (SetEvent(self.cancel_event) == .FALSE)
+            return windows.unexpectedError(windows.GetLastError());
+    }
+
+    fn waitForInputOrCancellation(self: *WindowsTty) !bool {
+        const handles = [_]windows.HANDLE{ self.stdin, self.cancel_event };
+        const result = WaitForMultipleObjects(@intCast(handles.len), &handles, .FALSE, infinite_timeout);
+        return switch (result) {
+            wait_object_0 => true,
+            wait_object_0 + 1 => false,
+            wait_failed => windows.unexpectedError(windows.GetLastError()),
+            else => error.Unexpected,
+        };
+    }
 
