# Nova local patch: vxfw FocusHandler empty-path guards (SIGSEGV in ReleaseFast).
# See AGENTS.md 'vxfw FocusHandler crash' and build.zig checkVaxisFocusPatch.
# Re-apply after every `zig build --fetch` / vaxis bump; build.zig enforces this.
diff -u a/src/vxfw/App.zig b/src/vxfw/App.zig
--- a/src/vxfw/App.zig
+++ b/src/vxfw/App.zig
@@ -544,7 +544,16 @@
         // in this tree. If this is the case, we refocus to the root widget
         _ = try self.childHasFocus(allocator, surface);
 
-        if (!self.root.eql(surface.widget)) {
+        // NOVA-LOCAL-PATCH: when the focused widget isn't in the surface tree
+        // (e.g. destroyed by an external runtime swap), childHasFocus leaves
+        // the path empty and the next handleEvent would dereference it. Fall
+        // back to the root widget, which is always present. The original guard
+        // only appended root when surface.widget differed from it, leaving the
+        // path empty in the common surface.widget == self.root case.
+        if (self.path_to_focused.items.len == 0) {
+            try self.path_to_focused.append(allocator, self.root);
+            self.focused_widget = self.root;
+        } else if (!self.root.eql(surface.widget)) {
             // If the root of surface is not the initial widget, we append the initial widget
             try self.path_to_focused.append(allocator, self.root);
         }
@@ -587,7 +596,9 @@
 
     fn handleEvent(self: *FocusHandler, ctx: *vxfw.EventContext, event: vxfw.Event) anyerror!void {
         const path = self.path_to_focused.items;
-        assert(path.len > 0);
+        // NOVA-LOCAL-PATCH: assert(path.len > 0) is stripped in ReleaseFast and
+        // became a SIGSEGV when the path was empty. Guard explicitly instead.
+        if (path.len == 0) return;
 
         // Capturing phase. We send capture events from the root to the target (inclusive of target)
         ctx.phase = .capturing;
